// ======================== АРМИЯ ПАЗАР + 30 ФЕНТЪЗИ ЕДИНИЦИ ========================
(function() {
    if (!window.worldData || !window.worldData.clans) {
        console.error("worldData не е зареден!");
        return;
    }

    let currentClanId = window.playerClan || "Дуло";
    const clan = window.worldData.clans[currentClanId];
    if (!clan) {
        console.error(`Клан ${currentClanId} не съществува!`);
        return;
    }

    // ---- Основни типове (човешки) ----
    const basicTroops = [
        { id: "infantry", name: "⚔️ Пехотинец", basePrice: 10, attack: 8, defense: 12, icon: "🛡️", desc: "Основна пехота – добра защита", special: null },
