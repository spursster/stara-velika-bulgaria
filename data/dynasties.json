// ui_panels/dynasties_panel.js
// Safe, versioned, fully compatible with new main.js + index.html

(function () {
  const panel = document.getElementById('panel-left');
  if (!panel) return;

  function renderLoading() {
    panel.innerHTML = `
      <h3>Dynasties</h3>
      <div id="dyn-list">Loading...</div>
    `;
  }

  function renderError() {
    panel.innerHTML = `
      <h3>Dynasties</h3>
      <div id="dyn-list" style="color:#900">Failed to load dynasties.json</div>
    `;
  }

  function renderList(list) {
    panel.innerHTML = `
      <h3>Dynasties</h3>
      <div id="dyn-list"></div>
    `;
    const container = document.getElementById('dyn-list');

    if (!list || !Array.isArray(list) || list.length === 0) {
      container.textContent = "No dynasties found";
      return;
    }

    list.forEach(d => {
      const item = document.createElement('div');
      item.style.marginBottom = "6px";
      item.textContent = `${d.name || d.key || "—"} (${d.startYear || "-"})`;
      container.appendChild(item);
    });
  }

  // Initial render
  renderLoading();

  // Load JSON with versioning to bypass GitHub cache
  fetch("data/dynasties.json?v=33", { cache: "no-store" })
    .then(r => {
      if (!r.ok) throw new Error("HTTP " + r.status);
      return r.json();
    })
    .then(json => renderList(json))
    .catch(err => {
      console.error("Error loading dynasties.json:", err);
      renderError();
    });

})();
